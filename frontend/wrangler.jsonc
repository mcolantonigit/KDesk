// Despliegue del frontend en Cloudflare Workers (archivos estáticos).
// Workers Builds corre "npm run build" y después "npx wrangler deploy"
// desde esta carpeta. El "name" tiene que coincidir con el nombre del
// Worker en el panel de Cloudflare.
//
// Pendiente (1.3): sumar el Worker que reenvía /api/* al Tunnel del server
// ("main" + "assets.run_worker_first": ["/api/*"]).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kdesk",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Rutas de React Router (/tickets/208, etc.): cualquier ruta que no sea
    // un archivo devuelve index.html
    "not_found_handling": "single-page-application"
  }
}
