PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=kdesk
DB_USER=postgres
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRES_IN=8h

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP_FROM debe coincidir con SMTP_USER (Microsoft 365 exige que el
# remitente sea la misma cuenta autenticada, salvo permiso de "Enviar como")
SMTP_FROM="KDesk <noreply@kalop.com.ar>"

# Los links de los mails (activación, reset de contraseña) usan esta URL.
# "localhost" solo funciona en la máquina que corre el backend: para que
# los links sirvan desde otras PCs de la red, usar la IP de esa máquina
# (ej. http://192.168.20.70:5173). Cuando haya un dominio/DNS real de
# producción, este valor pasa a ser ese dominio.
FRONTEND_URL=http://localhost:5173
