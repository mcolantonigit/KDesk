PORT=4000

# Dominios de correo corporativo habilitados para registrarse (separados
# por coma). El login/registro rechaza cualquier correo que no termine en
# alguno de estos dominios.
ALLOWED_EMAIL_DOMAINS=tuempresa.com

DB_HOST=localhost
DB_PORT=5432
DB_NAME=kdesk
DB_USER=postgres
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRES_IN=8h

# Cookie del login: en true solo si el sitio se sirve por HTTPS (si se
# manda en true sin HTTPS, el navegador descarta la cookie y el login
# queda roto sin ningún error visible). En intranet sin TLS, dejar false.
COOKIE_SECURE=false

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP_FROM debe coincidir con SMTP_USER (Microsoft 365 exige que el
# remitente sea la misma cuenta autenticada, salvo permiso de "Enviar como")
SMTP_FROM="KDesk <noreply@tuempresa.com>"

# Los links de los mails (activación, reset de contraseña) usan esta URL.
# "localhost" solo funciona en la máquina que corre el backend: para que
# los links sirvan desde otras PCs de la red, usar la IP de esa máquina
# (ej. http://192.168.20.70:5173). Cuando haya un dominio/DNS real de
# producción, este valor pasa a ser ese dominio.
FRONTEND_URL=http://localhost:5173

# Carpeta donde están pg_dump.exe / psql.exe (herramientas de línea de
# comandos que instala PostgreSQL, usadas para Backups). Si el server ya
# los tiene en el PATH del sistema, dejar vacío. Si no, poner la ruta a
# la carpeta "bin" de la instalación de Postgres
# (ej. C:\Program Files\PostgreSQL\18\bin).
PG_BIN_DIR=

# --- Solo para el entorno de desarrollo (branch develop) ---
# Si TLS_PFX_PATH queda vacío/ausente, el backend levanta en HTTP plano
# (sin certificado). En producción tiene que estar completo.
TLS_PFX_PATH=
TLS_PFX_PASSWORD=

# Si se define, TODO mail (activación, reset) se manda a esta casilla en
# lugar de al destinatario real. Dejar vacío en producción.
MAIL_REDIRECT_TO=
